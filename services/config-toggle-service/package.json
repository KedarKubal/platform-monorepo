{
  "name": "config-toggle-service",
  "version": "1.0.0",
  "description": "Lightweight Node.js/Express feature-flag and config toggle microservice with file-backed persistence, API-key auth, and a toggle dashboard.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint src tests server.js",
    "lint:fix": "eslint src tests server.js --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" server.js"
  },
  "keywords": ["feature-flags", "config-toggle", "express", "nodejs"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
