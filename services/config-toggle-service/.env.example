# Copy to .env and adjust for your environment.

NODE_ENV=development
PORT=3000

# Comma-separated list of keys allowed to perform write operations.
# Never commit real keys — this is an example only.
API_KEYS=dev-local-key,ci-pipeline-key

# CORS origin allowed to call the API (use a specific origin in production).
CORS_ORIGIN=*

# Optional override for where flag state is persisted.
# DATA_FILE_PATH=/data/flags.json
