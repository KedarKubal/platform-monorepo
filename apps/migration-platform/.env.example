# Target (normalized) database — where migrated data lands
TARGET_DB_URL=postgresql+psycopg2://migration_user:migration_pass@localhost:5432/target_db

# Legacy source database — where legacy tables are read from
LEGACY_DB_URL=postgresql+psycopg2://migration_user:migration_pass@localhost:5432/legacy_db

# Batch size for load-layer upserts
LOAD_BATCH_SIZE=500
